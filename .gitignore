# === secrets: nothing in here ever gets committed ===
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
serviceAccountKey.json
*-firebase-adminsdk-*.json
credentials.json
secrets/

# === deployment site details (keep the exact location private) ===
site/
*.site.yaml
deployment-coords.*

# === Node / Expo (app/) ===
node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.tsbuildinfo
npm-debug.*
yarn-error.log
.pnpm-debug.log

# native dirs are generated by prebuild, not source of truth
app/ios/
app/android/

# === Python (edge/ and server/) ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === local detection data (huge, regenerable) ===
edge/data/*.db
edge/data/*.csv
edge/logs/
*.sqlite3

# === macOS ===
.DS_Store
.AppleDouble
._*

# === editors ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
