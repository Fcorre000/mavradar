rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Crossing status and history: readable by any app user, written only by the server.
    // Server writes use the Admin SDK, which bypasses these rules.
    match /crossings/{usdotId} {
      allow read: if request.auth != null;
      match /events/{eventId} {
        allow read: if request.auth != null;
      }
      match /summary/ {range}{
        allow get: if request.auth !=null
        && range in ['7d', '30d'];
      }
    }

    // Device registry, keyed on the push token, not the uid (Amendment 002, 4.1).
    // The app registers with a merge write of uid, platform, and updatedAt, so
    // subscriptions and quietHours are optional and survive re-registration.
    match /devices/{fcmToken} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if validDevice();
      allow update: if validDevice() && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    function validDevice() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly([
          'uid', 'platform', 'subscriptions', 
          'alertTypes', 'minBlockMin', 'commuteWindows', 
          'quietHours', 'updatedAt', 'timeZone'
        ])
        && d.keys().hasOnly([
          'uid', 'platform', 'subscriptions', 
          'alertTypes', 'minBlockMin', 'commuteWindows', 
          'quietHours', 'updatedAt', 'timeZone'
        ])
        && d.uid is string
        && d.uid == request.auth.uid
        && d.platform is string
        && d.platform in ['android', 'ios']
        && d.updatedAt == request.time
        && validSubscriptions(d.subscriptions)
        && validAlertTypes(d.alertTypes)
        && d.minBlockMin is int
        && d.minBlockMin in [1,3,5]
        && validQuietHours(d.quietHours)
        && validCommuteWindows(d.commuteWindows)
        && d.timeZone is string
        && d.timeZone.size() >=3
        && d.timeZone.size() <= 64
    }

    function validSubscriptions(s) {
      return s is list
        && s.size() <= 20;
    }

    function validAlertTypes(a) {
      return a is map
        && a.keys().hasAll([
          'approaching', 'blocked', 'stopped', 'cleared'
        ])
        && a.keys().hasOnly([
          'approaching', 'blocked', 'stopped', 'cleared'
        ])
        && a.approaching is bool
        && a.blocked is bool
        && a.stopped is bool
        && a.cleared is bool;
    }

    function validTime(t) {
      return t is string
        && t.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        );
    }

    function validQuietHours(q) {
      return q == null || (
        q is map
        && q.keys().hasAll(['start', 'end'])
        && q.keys().hasOnly(['start', 'end'])
        && validTime(q.start)
        && validTime(q.end)
      );
    }

    function validDays(days) {
      return days is list
        && days.size() > 0
        && days.size() <= 7
        && days.hasOnly([1, 2, 3, 4, 5, 6, 7]);
    }

    function validWindow(w) {
      return w is map
        && w.keys().hasAll(['days', 'start', 'end'])
        && w.keys().hasOnly(['days', 'start', 'end'])
        && validDays(w.days)
        && validTime(w.start)
        && validTime(w.end);
    }

    function validCommuteWindows(w) {
      return w == null || (
        w is list
        && w.size() > 0
        && w.size() <= 2
        && validWindow(w[0])
        && (w.size() == 1 || validWindow(w[1]))
      );
    }

    // All other data remains server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}