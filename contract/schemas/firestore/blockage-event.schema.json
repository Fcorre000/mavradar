{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavradar.app/contract/blockage-event.schema.json",
  "title": "BlockageEvent",
  "description": "crossings/{usdotId}/events/{blockageId}: one finished blockage. Writer: server, after the blockage clears. Reader: app.",
  "type": "object",
  "required": ["start", "end", "durationMin", "stopped"],
  "additionalProperties": false,
  "properties": {
    "start": { "$ref": "#/$defs/timestamp" },
    "end": { "$ref": "#/$defs/timestamp" },
    "durationMin": { "type": "number", "minimum": 0 },
    "stopped": { "type": "boolean", "description": "Whether the train stopped during it" }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time", "x-firestore": "timestamp" }
  }
}
