{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavradar.app/contract/device.schema.json",
  "title": "Device",
  "description": "devices/{fcmToken}: one phone. The document ID is the push token; the body never holds it. Writer: the app, through registerDevice(). Reader: server. Until A3, firestore.rules allows only uid, platform, subscriptions, quietHours and updatedAt.",
  "type": "object",
  "required": ["uid", "platform", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "uid": { "type": "string", "minLength": 1, "description": "Anonymous auth uid; authorizes writes, isn't the identity" },
    "platform": { "enum": ["android", "ios"] },
    "updatedAt": { "$ref": "#/$defs/timestamp", "description": "Must equal the request time (rules)" },
    "subscriptions": { "type": "array", "items": { "$ref": "#/$defs/crossingId" }, "maxItems": 20, "uniqueItems": true, "description": "Followed crossings" },
    "quietHours": {
      "oneOf": [
        {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/hhmm" },
            "end": { "$ref": "#/$defs/hhmm" }
          }
        },
        { "type": "null" }
      ],
      "description": "Set while quiet hours are on. Times of day in timeZone."
    },
    "alertTypes": {
      "type": "object",
      "required": ["approaching", "blocked", "stopped", "cleared"],
      "additionalProperties": false,
      "properties": {
        "approaching": { "type": "boolean" },
        "blocked": { "type": "boolean" },
        "stopped": { "type": "boolean" },
        "cleared": { "type": "boolean" }
      }
    },
    "minBlockMin": { "enum": [1, 3, 5] },
    "commuteWindows": {
      "type": ["array", "null"],
      "description": "Set while commute windows are on. Times of day in timeZone.",
      "items": {
        "type": "object",
        "required": ["days", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "days": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "minItems": 1, "uniqueItems": true, "description": "ISO weekdays, 1 = Monday" },
          "start": { "$ref": "#/$defs/hhmm" },
          "end": { "$ref": "#/$defs/hhmm" }
        }
      }
    },
    "timeZone": { "type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$", "description": "IANA time zone name, like America/Chicago" }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time", "x-firestore": "timestamp" },
    "crossingId": { "type": "string", "pattern": "^[0-9]{6}[A-Z]$", "description": "USDOT crossing ID" },
    "hhmm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "24-hour time of day, HH:MM" }
  }
}
