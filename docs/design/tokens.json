{
  "meta": {
    "name": "MavRadar design tokens",
    "direction": "Signal, calm by default (design handoff v2)",
    "brand": "Transit Navy (chosen 2026-09-27)",
    "version": "2.0.0",
    "canvas": "https://claude.ai/artifact/Bt3AFTrrqTyxD3jk9vFX8E",
    "units": "Sizes are dp, type sizes are sp. Colors are sRGB hex.",
    "notes": [
      "Contrast ratios were computed by hand from the WCAG luminance formula. Re-check any color you change.",
      "Status colors mean status. Nothing else in the UI uses them, except the Today timeline and History bars, which show past blockages."
    ]
  },

  "color": {
    "neutral": {
      "comment": "Transit Navy, the chosen brand (2026-09-27).",
      "light": {
        "bg": "#FBFAF7",
        "surface": "#F1EFE9",
        "textPrimary": "#13213A",
        "textSecondary": "#4B566A",
        "divider": "#E3E0D8",
        "outline": "#C8C4BA",
        "navIndicator": "#DCEBFF",
        "actionSurface": "#DCEBFF",
        "actionOutline": "#4A90E2",
        "tonal": "#E8ECF3",
        "track": "#EAE7E0",
        "sheet": "#FFB366",
        "sheetHandle": "#C8C4BA",
        "primary": "#1B3A66",
        "onPrimary": "#FFFFFF",
        "link": "#1B3A66",
        "scrim": "rgba(0,0,0,0.45)",
        "snackbarBg": "#1B2A42",
        "snackbarText": "#EEF2F8",
        "snackbarAction": "#A9C4EC",
        "sensorOk": "#007A6E"
      },
      "dark": {
        "bg": "#0D1522",
        "surface": "#152033",
        "textPrimary": "#EEF2F8",
        "textSecondary": "#AEB9CB",
        "divider": "#22304A",
        "outline": "#33425E",
        "navIndicator": "#23395C",
        "tonal": "#1C2A42",
        "track": "#22304A",
        "sheet": "#152033",
        "sheetHandle": "#4A5A78",
        "primary": "#A9C4EC",
        "onPrimary": "#0D1522",
        "link": "#A9C4EC",
        "scrim": "rgba(0,0,0,0.6)",
        "snackbarBg": "#DCE4F0",
        "snackbarText": "#13213A",
        "snackbarAction": "#1B3A66",
        "sensorOk": "#7FD9CC"
      }
    },

    "brandCandidates": {
      "decided": "transitNavy",
      "comment": "Transit Navy was chosen on 2026-09-27 and color.neutral above holds its full set. The others are kept for reference. Each scheme only changes neutrals and primary; status colors never change. All pass AA; none uses red, amber, teal-green or purple, so a brand color can't read as a crossing state. Mirrored in app/src/constants/theme.ts (BrandSchemes).",
      "graphite":     { "light": { "bg": "#FFFFFF", "surface": "#F6F7F9", "text": "#111418", "textSecondary": "#4A5260", "selected": "#E3E6EB", "primary": "#111418", "onPrimary": "#FFFFFF" }, "dark": { "bg": "#121212", "surface": "#1B1E22", "text": "#F2F4F7", "textSecondary": "#B6BDC8", "selected": "#2C3137", "primary": "#F2F4F7", "onPrimary": "#121212" } },
      "transitNavy":  { "light": { "bg": "#FBFAF7", "surface": "#F1EFE9", "text": "#13213A", "textSecondary": "#4B566A", "selected": "#DCE4F0", "primary": "#1B3A66", "onPrimary": "#FFFFFF" }, "dark": { "bg": "#0D1522", "surface": "#152033", "text": "#EEF2F8", "textSecondary": "#AEB9CB", "selected": "#23395C", "primary": "#A9C4EC", "onPrimary": "#0D1522" } },
      "cobalt":       { "light": { "bg": "#FFFFFF", "surface": "#F4F6FB", "text": "#0F1523", "textSecondary": "#4A5366", "selected": "#DDE6FF", "primary": "#2350C8", "onPrimary": "#FFFFFF" }, "dark": { "bg": "#0E1117", "surface": "#171C27", "text": "#F0F3FA", "textSecondary": "#B2BACB", "selected": "#24345E", "primary": "#9DB6FF", "onPrimary": "#0E1117" } },
      "prairieSlate": { "light": { "bg": "#F7F5F0", "surface": "#EFECE5", "text": "#1C2227", "textSecondary": "#525A61", "selected": "#DDE3E7", "primary": "#3B5163", "onPrimary": "#FFFFFF" }, "dark": { "bg": "#121517", "surface": "#1B2024", "text": "#EEF0F1", "textSecondary": "#B3BBC1", "selected": "#2B3A45", "primary": "#B7C8D6", "onPrimary": "#121517" } },
      "railtie":      { "light": { "bg": "#FAF7F2", "surface": "#F2EDE5", "text": "#231B15", "textSecondary": "#5A5048", "selected": "#E8DDD0", "primary": "#4A3528", "onPrimary": "#FFFFFF" }, "dark": { "bg": "#15110E", "surface": "#1F1915", "text": "#F4EEE7", "textSecondary": "#C0B4A7", "selected": "#3A2E24", "primary": "#E2CDB5", "onPrimary": "#15110E" } }
    },

    "statusCard": {
      "light": {
        "clear":       { "container": "#E0F2EF", "onContainer": "#00594F", "icon": "#007A6E", "iconGlyph": "#FFFFFF", "contrast": "7.1:1" },
        "approaching": { "container": "#FFE8A3", "onContainer": "#5C3A00", "icon": "#F2A900", "iconGlyph": "#1A1A1A", "iconBorder": "#1A1A1A", "contrast": "8.4:1" },
        "blocked":     { "container": "#C62828", "onContainer": "#FFFFFF", "icon": "#FFFFFF", "iconGlyph": "#C62828", "contrast": "5.6:1" },
        "stopped":     { "container": "#8E1B1B", "onContainer": "#FFFFFF", "icon": "#FFFFFF", "iconGlyph": "#8E1B1B", "stripeBand": "rgba(255,255,255,0.12)", "contrast": "9.0:1" },
        "unknown":     { "container": "#ECEEF1", "onContainer": "#3D4450", "border": "2dp dashed #6B7280", "contrast": "8.4:1" }
      },
      "dark": {
        "clear":       { "container": "#0E2A27", "onContainer": "#7FD9CC", "icon": "#7FD9CC", "iconGlyph": "#0E2A27", "contrast": "9.2:1" },
        "approaching": { "container": "#3A2C00", "onContainer": "#FFD66B", "icon": "#F2A900", "iconGlyph": "#1A1A1A", "iconBorder": "#1A1A1A", "contrast": "9.8:1" },
        "blocked":     { "container": "#8C1D18", "onContainer": "#FFFFFF", "icon": "#FFFFFF", "iconGlyph": "#8C1D18", "contrast": "9.1:1" },
        "stopped":     { "container": "#5E0F0F", "onContainer": "#FFFFFF", "icon": "#FFFFFF", "iconGlyph": "#5E0F0F", "stripeBand": "rgba(255,255,255,0.12)", "contrast": ">12:1" },
        "unknown":     { "container": "#22262B", "onContainer": "#C9CED6", "border": "2dp dashed #8A919C", "contrast": "9.6:1" }
      }
    },

    "strong": {
      "comment": "Markers, notification icon circles, list and sheet icons. Same in both themes.",
      "clear":       { "fill": "#007A6E", "glyph": "#FFFFFF" },
      "approaching": { "fill": "#F2A900", "glyph": "#1A1A1A", "border": "#1A1A1A" },
      "blocked":     { "fill": "#C62828", "glyph": "#FFFFFF" },
      "stopped":     { "fill": "#8E1B1B", "glyph": "#FFFFFF" },
      "unknown":     { "fill": "#6B7280", "glyph": "#FFFFFF" }
    },

    "marker": {
      "ring": "#FFFFFF",
      "ringWidth": 2,
      "outerStroke": "rgba(0,0,0,0.4)",
      "outerStrokeWidth": 1,
      "clusterFill": { "light": "#FFFFFF", "dark": "#2C3137" },
      "clusterText": { "light": "#111418", "dark": "#F2F4F7" },
      "detourPin": { "light": "#4A5260", "dark": "#8A919C" },
      "labelPill": { "light": { "bg": "#FFFFFF", "border": "#E3E6EB" }, "dark": { "bg": "#1B1E22", "border": "#2C3137" } }
    },

    "history": {
      "light": { "moving": "#C62828", "stopped": "#8E1B1B", "noData": "#6B7280", "neutralBar": "#AEB4BD", "peakBar": "#111418" },
      "dark":  { "moving": "#EF5350", "stopped": "#C0392B", "noData": "#8A919C", "neutralBar": "#5A616B", "peakBar": "#F2F4F7" }
    },

    "map": {
      "comment": "Google Maps JSON style, no Map ID. Status markers are the only saturated color on the map.",
      "light": { "land": "#EEF0F2", "road": "#FFFFFF", "roadCasing": "#D8DCE1", "rail": "#8A919C", "label": "#6B7280", "water": "#D5DEE7", "park": "#E3E9E5", "poiLabels": "off", "transit": "30%" },
      "dark":  { "land": "#1B1E22", "road": "#2C3137", "roadCasing": "#24282D", "rail": "#8A919C", "label": "#8A919C", "water": "#1E2A33", "park": "#1F2624" }
    },

    "notification": {
      "accent": { "blocked": "#C62828", "stopped": "#8E1B1B", "cleared": "#007A6E", "unknown": "#6B7280" }
    }
  },

  "typography": {
    "family": {
      "sans": "Atkinson Hyperlegible Next",
      "fallback": "sans-serif",
      "numerals": "tabular-nums on every time and duration",
      "source": "Google Fonts, OFL, load with expo-font"
    },
    "scale": {
      "stateWord":    { "size": 48, "lineHeight": 52, "weight": 700, "maxFontSizeMultiplier": 1.1 },
      "duration":     { "size": 32, "lineHeight": 36, "weight": 600, "maxFontSizeMultiplier": 1.25 },
      "stateLine":    { "size": 20, "lineHeight": 26, "weight": 600, "maxFontSizeMultiplier": 1.5 },
      "crossingName": { "size": 22, "lineHeight": 28, "weight": 600, "maxFontSizeMultiplier": 1.5 },
      "sheetName":    { "size": 20, "lineHeight": 26, "weight": 600 },
      "body":         { "size": 16, "lineHeight": 24, "weight": 400 },
      "secondary":    { "size": 14, "lineHeight": 20, "weight": 400 },
      "kicker":       { "size": 13, "lineHeight": 16, "weight": 500, "letterSpacing": 0.2 },
      "disclaimer":   { "size": 13, "lineHeight": 18, "weight": 400 },
      "button":       { "size": 16, "lineHeight": 21, "weight": 600, "maxFontSizeMultiplier": 1.5 },
      "buttonSub":    { "size": 13, "lineHeight": 17, "weight": 400, "maxFontSizeMultiplier": 1.5 },
      "navLabel":     { "size": 12, "lineHeight": 16, "weight": 500, "activeWeight": 700, "maxFontSizeMultiplier": 1.3 },
      "axis":         { "size": 11, "lineHeight": 14, "weight": 400, "maxFontSizeMultiplier": 1.3 }
    }
  },

  "spacing": {
    "grid": 4,
    "screenPadding": 20,
    "cardPadding": 20,
    "sectionGap": 16,
    "stackGap": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24 },
    "topInset": 36,
    "actionAboveNav": 12
  },

  "radius": {
    "card": 20,
    "button": 16,
    "sheet": 28,
    "notification": 24,
    "widget": 24,
    "chip": 8,
    "snackbar": 8,
    "segmented": 20,
    "timelineBar": 4,
    "full": 999
  },

  "size": {
    "touchTarget": 48,
    "button": 56,
    "row": 48,
    "listRow": 72,
    "settingsRow": 72,
    "header": 64,
    "navBar": 80,
    "navIndicator": { "width": 64, "height": 32 },
    "statusCardMinHeight": 288,
    "stateIcon": 40,
    "sheetIcon": 24,
    "listIcon": 32,
    "marker": 36,
    "markerSelected": 44,
    "markerHitArea": 48,
    "cluster": 40,
    "followBadge": 12,
    "sheetPeek": 120,
    "sheetHalf": 440,
    "stripeBand": 8,
    "timelineBar": 20,
    "switch": { "width": 52, "height": 32, "thumbOn": 24, "thumbOff": 16 },
    "widget2x2": { "width": 176, "height": 176 },
    "widget4x1": { "width": 364, "height": 80 }
  },

  "motion": {
    "stateCrossfadeMs": 200,
    "liveDotPulseMs": 2000,
    "sheetSnapMs": 250,
    "reduceMotion": "Turn off the live dot pulse and crossfades. Never flash."
  },

  "freshness": {
    "liveMaxSeconds": 30,
    "delayedMaxSeconds": 90,
    "rule": "Past 90 s the card switches to Unknown and never shows the last state word. Engineering sets final numbers to match the sensor heartbeat."
  }
}
