# edge service configuration. Copy to .env and fill in. No keys or secrets here; the node key
# arrives with E3.

MAVRADAR_NODE_ID=node-a
MAVRADAR_NODE_CROSSING_ID=794980D

# On unless set to false: every event is marked log-only, so the server records it and alerts
# nobody. Only turn it off on purpose, once the false-alarm rate has been measured (D1).
# MAVRADAR_NODE_LOG_ONLY=true

# Play a recorded log instead of the radar (format: tests/data/README.md).
# MAVRADAR_NODE_REPLAY_LOG=tests/data/train_passing.jsonl
# 1 is real speed, 10 is ten times faster, 0 is no waiting.
# MAVRADAR_NODE_REPLAY_SPEED=1
# Size of one raw range band in metres (the radar reports it with ?z). 1 until checked on the real OPS243-C.
# MAVRADAR_NODE_RANGE_BIN_M=1

# OmniPreSense's sample recordings (bikes and a walker) for the no-train tests: uv run python -m scripts.fetch_recordings

# Detector thresholds (mavradar_edge/detector/settings.py). Starting values: the log-only weeks
# exist to retune them. Unset keeps the default.
# MAVRADAR_NODE_MIN_MAGNITUDE=40          raw magnitude a reading needs to count at all
# MAVRADAR_NODE_GAP_S=3                    a track survives this gap (between cars)
# MAVRADAR_NODE_APPROACH_DURATION_S=4      approaching: moving toward the crossing this long
# MAVRADAR_NODE_PRESENT_DURATION_S=10      present: this long, at train speed, in the track band
# MAVRADAR_NODE_MIN_SPEED_MPS=3
# MAVRADAR_NODE_TRACK_BAND_MIN_M=18
# MAVRADAR_NODE_TRACK_BAND_MAX_M=23
# MAVRADAR_NODE_BAND_WINDOW_S=5            "in the band" means seen there within this long
# MAVRADAR_NODE_OC_MIN_TIME_S=10           the OC double-check says train if both hold
# MAVRADAR_NODE_OC_MIN_LENGTH_M=100
