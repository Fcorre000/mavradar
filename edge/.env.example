# edge service configuration. Copy to .env and fill in. No keys or secrets here; the node key
# arrives with E3.

MAVRADAR_NODE_ID=node-a
MAVRADAR_NODE_CROSSING_ID=794980D

# On unless set to false: every event is marked log-only, so the server records it and alerts
# nobody. Only turn it off on purpose, once the false-alarm rate has been measured (D1).
# MAVRADAR_NODE_LOG_ONLY=true

# Play a recorded log instead of the radar (format: tests/data/README.md).
# MAVRADAR_NODE_REPLAY_LOG=tests/data/train_passing.jsonl
# 1 is real speed, 10 is ten times faster, 0 is no waiting.
# MAVRADAR_NODE_REPLAY_SPEED=1
