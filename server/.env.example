# server configuration. Copy to .env and fill in. No keys or secrets here.

# Reported by GET /health. Defaults to "dev".
MAVRADAR_VERSION=dev

# Each field node's key hash and crossing, as JSON. Make a key and its hash with
#   uv run python -m scripts.new_node_key
# The raw key goes on the node only, never here. Without this, every POST /events gets 401.
# MAVRADAR_NODES={"node-a": {"key_hash": "<64 hex characters from the script>", "crossing_id": "794980D"}}

# Each crossing's alert mode, as JSON: logOnly, blockedAndCleared or all. A crossing that isn't
# listed is logOnly, so nothing alerts until someone switches it on (D1). OQ19 keeps approaching
# pushes off while there is one node, so blockedAndCleared is as far as it goes for now.
# MAVRADAR_ALERT_MODES={"794980D": "blockedAndCleared"}

# Push sending. Dry run is on unless you turn it off: FCM checks every message, and nothing reaches
# a phone. Only turn it off on purpose, for a real test on your own phone or for the live service.
# Credentials come from Application Default Credentials (gcloud locally, the service account on
# Cloud Run), never a key file. To check messages against real FCM with your dev build's token:
#   uv run python -m scripts.dry_run_push <token>
# MAVRADAR_FCM_DRY_RUN=true
# MAVRADAR_FIREBASE_PROJECT_ID=mavradar-4a74a
